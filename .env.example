FSM_HOST=0.0.0.0
FSM_PORT=8484
FSM_APP_KEYS={"default":"replace-me"}

# Comma-separated MIME allowlist for the media routes; empty = accept any type.
FSM_ALLOWED_MIME_TYPES=
# Shared upload size cap (bytes) for both the media and S3-compatible routes.
FSM_MAX_UPLOAD_BYTES=104857600
# When true, FSM_MAX_UPLOAD_BYTES is ignored entirely for both route sets.
FSM_UNLIMITED_UPLOADS=false

# S3-compatible API credentials: maps an access key id to its secret and the
# app slug (bucket) it is allowed to use. One entry per consumer application.
FSM_S3_CREDENTIALS={"replace-with-access-key-id":{"secret_access_key":"replace-me","app":"default"}}
FSM_S3_REGION=us-east-1
FSM_S3_MAX_EXPIRES_SECONDS=604800

